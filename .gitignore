# 构建产物
/dist/
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
wafd
wafdctl

# 测试与覆盖率
*.out
*.test
coverage.*
/testdata/tmp/
.tmp/

# 运行时产物（本地调试用，不进版本库）
/logs/
*.jsonl
*.log
*.pid

# 压测与基准原始数据（原始数据不进库）
/bench-out/
*.prof
*.trace

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# Go 工作区
go.work
go.work.sum

# 本地配置覆盖（示例配置 config.example.yaml 进库，真实配置不进）
config.local.yaml
*.local.yaml

# 设计文档与内部记录：保留在本地，但不随仓库发布
# （产品说明以 README.md 为准；这里放的是设计稿、性能预算、控制台设计、
#   规则 DSL 规格、验收记录与安全审计记录）
/docs/

# codegraph 的本地索引（工具产物，不进版本库）
/.codegraph/

# Python 字节码缓存（可再生，不进仓库）
__pycache__/
*.pyc
